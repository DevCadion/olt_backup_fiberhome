# Permissões: este arquivo guarda todas as senhas -> chmod 600 .env

# ===== FTP (destino dos backups) =====
# Usuário e senha NÃO podem ter espaço ou aspas (vão na CLI da OLT).
# Use um usuário FTP exclusivo para os backups, preso (chroot) ao diretório.
FTP_IP=192.168.1.100
FTP_PORT=21
FTP_USER=backup_user
FTP_PASS=troque_esta_senha
# Diretório remoto (vazio = home do usuário FTP)
FTP_DIR=
# true = verificação/limpeza feitas via FTPS (exige TLS habilitado no servidor FTP).
# A OLT continua enviando em FTP simples.
FTP_TLS=false
# Quantos backups manter por OLT
KEEP_BACKUPS=2

# ===== E-mail (SMTP) =====
SMTP_SERVER=smtp.exemplo.com
SMTP_PORT=587
# none | starttls | ssl  (vazio: ssl na 465, starttls na 587, none nas demais)
# Com SMTP_PASS definido, "none" é recusado (senha nunca vai em texto claro).
SMTP_SECURITY=starttls
SMTP_USER=seu-email@exemplo.com
SMTP_PASS=sua-senha
# Remetente (padrão: SMTP_USER)
SMTP_FROM=
EMAIL_TO=admin@exemplo.com,monitor@exemplo.com

# ===== Tempo limite (segundos) =====
OLT_TIMEOUT=14
OLT_UPLOAD_TIMEOUT=120

# ===== OLTs =====
# Nomes: apenas letras, números e _ (ex.: OLT_SUL)
OLT_LIST=OLT01,OLT02

OLT01_IP=10.0.0.1
OLT01_USER=admin
OLT01_PASS=troque_esta_senha
OLT01_ENABLE_PASS=troque_esta_senha
# telnet (padrão) ou ssh, se o firmware da OLT suportar
OLT01_PROTO=telnet
# OLT01_PORT=23
# Só para SSH em firmware antigo, ex.: -o KexAlgorithms=+diffie-hellman-group14-sha1
# OLT01_SSH_OPTS=

OLT02_IP=10.0.0.2
OLT02_USER=admin
OLT02_PASS=troque_esta_senha
OLT02_ENABLE_PASS=troque_esta_senha
OLT02_PROTO=telnet
